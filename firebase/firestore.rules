rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'super_admin';
    }

    function isVendorMember(vendorId) {
      return signedIn() && (
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid ||
        exists(/databases/$(database)/documents/vendorStaff/$(vendorId + '_' + request.auth.uid))
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if resource.data.status == 'published' || isVendorMember(resource.data.vendorId) || isAdmin();
      allow create: if signedIn() && request.resource.data.vendorId is string
        && isVendorMember(request.resource.data.vendorId);
      allow update: if (isVendorMember(resource.data.vendorId) || isAdmin())
        && request.resource.data.vendorId == resource.data.vendorId;
      allow delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isVendorMember(resource.data.vendorId) || isAdmin();
      allow create: if signedIn() && isVendorMember(request.resource.data.vendorId);
      allow update: if (isVendorMember(resource.data.vendorId) || isAdmin())
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.storeId == resource.data.storeId;
      allow delete: if isVendorMember(resource.data.vendorId) || isSuperAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isVendorMember(resource.data.vendorId) ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
