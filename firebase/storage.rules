rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /public-product-media/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.token.vendorId == vendorId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.token.vendorId == vendorId;
    }

    match /private-vendor-files/{vendorId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.token.vendorId == vendorId;
      allow create, update: if signedIn() && request.auth.token.vendorId == vendorId
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.token.vendorId == vendorId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
